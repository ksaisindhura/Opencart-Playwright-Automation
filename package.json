{
  "name": "opencart-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript automation framework for web UI, API, and database testing",
  "scripts": {
    "test:api": "playwright test --grep @api",
    "test:web": "playwright test --grep @web",
    "test:master": "playwright test --grep @master",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:datadriven": "playwright test --grep @datadriven",
    "test:master:headed": "playwright test --grep @sanity --headed",
    "test:sanity:debug": "playwright test --grep @sanity --debug"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation-testing",
    "opencart",
    "api-testing"
  ],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.5.0",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.10.2",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "luxon": "^3.7.2",
    "xlsx": "^0.18.5"
  }
}